<%- include('../_header', { title: 'Admin - Audit log', user, csrfToken }) %>

<h1>Audit log</h1>
<p class="text-sm text-base-content/60">Recent security-relevant events. Newest first. Capped at 100 per page.</p>

<% if (entries.length === 0) { %>
  <div class="card bg-base-200 border border-base-300 mt-3">
    <div class="card-body text-base-content/70">No entries yet.</div>
  </div>
<% } else { %>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-200 mt-3">
    <table class="table table-zebra table-sm">
      <thead>
        <tr><th>When</th><th>Actor</th><th>Action</th><th>Target</th><th>Details</th><th>IP</th></tr>
      </thead>
      <tbody>
        <% entries.forEach(function (e) { %>
          <tr>
            <td class="text-base-content/60 whitespace-nowrap" title="<%= e.created_at %>"><%= e.created_at_display %></td>
            <td><%= e.actor_username || '-' %></td>
            <td><code><%= e.action %></code></td>
            <td class="text-base-content/60">
              <% if (e.target_type) { %><%= e.target_type %>:<%= e.target_id %><% } else { %>-<% } %>
            </td>
            <td class="text-base-content/60 whitespace-normal max-w-[30rem]">
              <% if (e.details_parsed) { %>
                <code class="text-xs break-words"><%= JSON.stringify(e.details_parsed) %></code>
              <% } %>
            </td>
            <td class="text-base-content/60 font-mono text-xs"><%= e.ip || '-' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="flex gap-2 mt-4">
    <% if (prevOffset !== null) { %>
      <a class="btn btn-outline btn-sm" href="/admin/audit?offset=<%= prevOffset %>">&larr; Newer</a>
    <% } %>
    <% if (nextOffset !== null) { %>
      <a class="btn btn-outline btn-sm" href="/admin/audit?offset=<%= nextOffset %>">Older &rarr;</a>
    <% } %>
  </div>
<% } %>

<%- include('../_footer') %>
