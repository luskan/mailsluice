<%- include('../_header', { title: 'Admin - Users', user, csrfToken }) %>

<h1>Users</h1>

<% if (flash) { %>
  <div role="alert" class="alert alert-success text-sm my-3"><span><%= flash %></span></div>
<% } %>

<h2>Add user</h2>
<div class="card bg-base-200 border border-base-300 max-w-xl">
  <div class="card-body">
    <form method="POST" action="/admin/users" class="flex flex-col gap-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="form-control">
        <span class="label label-text">Username</span>
        <input type="text" name="username" class="input input-bordered w-full max-w-sm" required>
      </label>
      <label class="label cursor-pointer justify-start gap-2">
        <input type="checkbox" name="is_admin" value="1" class="checkbox checkbox-primary">
        <span class="label-text">Admin</span>
      </label>
      <div>
        <button type="submit" class="btn btn-primary btn-sm">Create user</button>
      </div>
      <p class="text-sm text-base-content/60">A random temporary password will be generated and shown here. The user should change it on first login.</p>
    </form>
  </div>
</div>

<h2>All users</h2>
<div class="overflow-x-auto rounded-box border border-base-300 bg-base-200">
  <table class="table table-zebra table-sm">
    <thead>
      <tr><th>ID</th><th>Username</th><th>Role</th><th>Created</th><th></th></tr>
    </thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <tr>
          <td><%= u.id %></td>
          <td class="font-medium"><%= u.username %></td>
          <td>
            <% if (u.is_admin) { %>
              <span class="badge badge-primary badge-sm">admin</span>
            <% } else { %>
              <span class="badge badge-ghost badge-sm">user</span>
            <% } %>
          </td>
          <td class="text-base-content/60" title="<%= u.created_at || '' %>"><%= u.created_at_display %></td>
          <td>
            <div class="inline-flex gap-1 flex-wrap">
              <form method="POST" action="/admin/users/<%= u.id %>/reset-password" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-xs btn-outline">Reset password</button>
              </form>
              <% if (u.id !== user.id) { %>
                <form method="POST" action="/admin/users/<%= u.id %>/delete" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-xs btn-error">Delete</button>
                </form>
              <% } %>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('../_footer') %>
