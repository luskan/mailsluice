<%- include('../_header', { title: 'Change password', user, csrfToken }) %>

<h1>Change password</h1>

<% if (flash) { %>
  <div role="alert" class="alert alert-success text-sm my-3"><span><%= flash %></span></div>
<% } %>
<% if (error) { %>
  <div role="alert" class="alert alert-error text-sm my-3"><span><%= error %></span></div>
<% } %>

<div class="card bg-base-200 border border-base-300 max-w-xl">
  <div class="card-body">
    <form method="POST" action="/account/password" class="flex flex-col gap-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="form-control">
        <span class="label label-text">Current password</span>
        <input type="password" name="current_password" class="input input-bordered w-full max-w-sm" required autocomplete="current-password" autofocus>
      </label>
      <label class="form-control">
        <span class="label label-text">New password</span>
        <input type="password" name="new_password" class="input input-bordered w-full max-w-sm" required minlength="<%= minLength %>" autocomplete="new-password">
      </label>
      <label class="form-control">
        <span class="label label-text">Confirm new password</span>
        <input type="password" name="confirm_password" class="input input-bordered w-full max-w-sm" required minlength="<%= minLength %>" autocomplete="new-password">
      </label>
      <div>
        <button type="submit" class="btn btn-primary btn-sm">Change password</button>
      </div>
      <p class="text-sm text-base-content/60">
        Minimum <%= minLength %> characters. Letters, digits, spaces, and symbols all count equally.
        A long passphrase made of four or five unrelated words is an easy way to hit the bar.
      </p>
    </form>
  </div>
</div>

<%- include('../_footer') %>
