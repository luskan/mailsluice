<%- include('../_header', { title: 'Change password', user, csrfToken }) %>

<h1>Change password</h1>

<% if (flash) { %>
  <div class="card ok"><%= flash %></div>
<% } %>
<% if (error) { %>
  <div class="card error"><%= error %></div>
<% } %>

<form class="stack" method="POST" action="/account/password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>
    Current password
    <input type="password" name="current_password" required autocomplete="current-password" autofocus>
  </label>
  <label>
    New password
    <input type="password" name="new_password" required minlength="<%= minLength %>" autocomplete="new-password">
  </label>
  <label>
    Confirm new password
    <input type="password" name="confirm_password" required minlength="<%= minLength %>" autocomplete="new-password">
  </label>
  <button type="submit">Change password</button>
  <p class="muted">
    Minimum <%= minLength %> characters. Letters, digits, spaces, and symbols all count equally.
    A long passphrase made of four or five unrelated words is an easy way to hit the bar.
  </p>
</form>

<%- include('../_footer') %>
