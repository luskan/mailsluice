<%- include('_header', { title: 'Home', user, csrfToken }) %>

<h1>Welcome, <%= user.username %></h1>

<% if (!hasDestinations) { %>
  <div class="card">
    <p>Start by connecting a destination mailbox (Gmail) so imported mail has somewhere to go.</p>
    <a class="btn" href="/destinations">Connect a destination</a>
  </div>
<% } else if (sources.length === 0) { %>
  <div class="card">
    <p>Destination ready. Add a source mailbox (IMAP or POP) to start importing mail.</p>
    <a class="btn" href="/sources/new">Add a source</a>
  </div>
<% } else { %>
  <h2>Sources</h2>
  <div class="table-scroll">
  <table>
    <thead><tr><th>Name</th><th>Type</th><th>Host</th><th>Tag</th><th>Enabled</th><th>Connected</th><th>Last sync</th><th>Imported</th><th>Skipped</th><th class="wrap">Last error</th></tr></thead>
    <tbody>
      <% sources.forEach(function(s) { %>
        <tr>
          <td><%= s.name %></td>
          <td><%= s.type %></td>
          <td><%= s.host %>:<%= s.port %></td>
          <td><%= s.destination_tag %></td>
          <td><%= s.enabled ? 'yes' : 'no' %></td>
          <td class="<%= s.connected ? 'ok' : 'muted' %>"><%= s.connected ? 'connected' : 'not connected' %></td>
          <td class="muted" title="<%= s.last_sync_at || '' %>"><%= s.last_sync_at_display %></td>
          <td><%= s.imported_count %></td>
          <td><%= s.skipped_count %></td>
          <td class="error wrap" style="max-width:22rem;"><%= s.last_error || '' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <p class="muted">
    <a href="/sources">Manage sources</a> &middot; <a href="/destinations">Manage destinations</a>
  </p>
<% } %>

<%- include('_footer') %>
