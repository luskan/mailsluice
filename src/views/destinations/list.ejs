<%- include('../_header', { title: 'Destination', user, csrfToken }) %>

<h1>Destination</h1>

<% if (flash) { %>
  <div role="alert" class="alert alert-success text-sm my-3"><span><%= flash %></span></div>
<% } %>

<% if (user.isAdmin) { %>
  <h2>Gmail OAuth client <span class="text-sm text-base-content/60 font-normal">(admin)</span></h2>
  <%- include('../admin/_gmail_oauth_panel', { csrfToken, flash: null, configured, client_id, client_secret_mask, redirect_uri, suggested_origin, suggested_redirect_uri }) %>
  <div class="divider my-8"></div>
  <h2 id="connect" class="scroll-mt-4">Your connected mailbox</h2>
<% } %>

<% if (destinations.length === 0) { %>
  <div class="card bg-base-200 border border-base-300">
    <div class="card-body">
      <p>No destination connected yet. Mail imported from your sources is injected into this mailbox.</p>
      <% if (adminConfigured) { %>
        <div class="card-actions">
          <a class="btn btn-primary" href="/destinations/gmail/connect">Connect Gmail</a>
        </div>
      <% } else { %>
        <p class="text-error">Gmail is not available yet -- an admin must configure OAuth credentials above
        <% if (!user.isAdmin) { %>. Please ask an administrator to set this up<% } %>.</p>
      <% } %>
    </div>
  </div>
<% } else { %>
  <% const d = destinations[0]; %>
  <div class="card bg-base-200 border border-base-300">
    <div class="card-body">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <div class="text-xs text-base-content/60 uppercase tracking-wider"><%= d.type %></div>
          <div class="text-lg font-semibold mt-1"><%= d.account_identifier || 'connected' %></div>
          <div class="text-sm text-base-content/60 mt-1">
            Connected <span title="<%= d.created_at || '' %>"><%= d.created_at_display %></span>
            <% if (!d.enabled) { %> &middot; <span class="text-error">disabled</span><% } %>
          </div>
        </div>
        <form method="POST" action="/destinations/<%= d.id %>/disconnect">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-error btn-sm">Disconnect</button>
        </form>
      </div>
      <p class="text-sm text-base-content/60 mt-4">
        Disconnecting revokes this Mailsluice's OAuth token with Google and removes any sources attached to this destination.
      </p>
    </div>
  </div>
<% } %>

<%- include('../_footer') %>
