<%- include('../_header', { title: 'Gmail not configured', user, csrfToken }) %>

<h1>Gmail not configured</h1>
<div role="alert" class="alert alert-error">
  <div>
    <p>An administrator must configure the Gmail OAuth client before users can connect their Gmail accounts.</p>
    <% if (user.isAdmin) { %>
      <div class="mt-3">
        <a class="btn btn-primary btn-sm" href="/admin/destinations/gmail">Configure Gmail OAuth now</a>
      </div>
    <% } else { %>
      <p class="text-sm mt-1">Please ask an administrator to set this up.</p>
    <% } %>
  </div>
</div>

<%- include('../_footer') %>
