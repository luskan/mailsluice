<%- include('../_header', { title: source ? 'Edit source' : 'Add source', user, csrfToken }) %>

<h1><%= source ? 'Edit source' : 'Add source' %></h1>

<% if (flash) { %>
  <div class="card error"><%= flash %></div>
<% } %>

<% if (destinations.length === 0) { %>
  <div class="card error">You need to connect a destination before adding a source. <a href="/destinations">Go to destinations</a>.</div>
<% } else { %>
  <details class="card" <%= source ? '' : 'open' %>>
    <summary><strong>Port and TLS cheat-sheet</strong></summary>
    <table style="margin-top:0.5rem;">
      <thead><tr><th>Protocol</th><th>Port</th><th>Use TLS</th><th>Notes</th></tr></thead>
      <tbody>
        <tr><td>IMAP</td><td><code>993</code></td><td>yes</td><td>Implicit TLS -- the default, use this.</td></tr>
        <tr><td>IMAP</td><td><code>143</code></td><td>no</td><td>Plaintext; only acceptable on a private network you trust.</td></tr>
        <tr><td>POP</td><td><code>995</code></td><td>yes</td><td>Implicit TLS -- the default, use this.</td></tr>
        <tr><td>POP</td><td><code>110</code></td><td>no</td><td>Plaintext; only on trusted networks.</td></tr>
      </tbody>
    </table>
    <p class="muted">If you see <em>"wrong version number"</em> or an SSL error, you have TLS ticked with a plaintext port (or vice versa). Match the combo above. STARTTLS (TLS on port 143 / 110 after a plaintext handshake) is not currently supported.</p>
  </details>

  <form class="stack" id="source-form" method="POST" action="<%= source ? `/sources/${source.id}` : '/sources' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (source) { %>
      <input type="hidden" name="source_id" value="<%= source.id %>">
    <% } %>
    <label>Name <input type="text" name="name" value="<%= source ? source.name : '' %>" required></label>
    <label>Type
      <select name="type" required>
        <option value="imap" <%= source && source.type === 'imap' ? 'selected' : '' %>>IMAP</option>
        <option value="pop" <%= source && source.type === 'pop' ? 'selected' : '' %>>POP</option>
      </select>
    </label>
    <label>Host <input type="text" name="host" value="<%= source ? source.host : '' %>" required></label>
    <label>Port <input type="number" name="port" value="<%= source ? source.port : 993 %>" required></label>
    <label><input type="checkbox" name="use_tls" value="1" <%= !source || source.use_tls === 1 ? 'checked' : '' %>> Use TLS</label>
    <label>Username <input type="text" name="username" value="<%= source ? source.username : '' %>" required autocomplete="off"></label>
    <label>Password <input type="password" name="password" autocomplete="new-password" placeholder="<%= source ? '(leave blank to keep current)' : '' %>"></label>
    <label>Destination
      <select name="destination_id" required>
        <% destinations.forEach(function(d) { %>
          <option value="<%= d.id %>" <%= source && source.destination_id === d.id ? 'selected' : '' %>><%= d.type %>: <%= d.account_identifier || ('id ' + d.id) %></option>
        <% }); %>
      </select>
    </label>
    <label>Label prefix (Gmail)
      <input type="text" id="label-prefix" name="destination_tag" value="<%= source ? source.destination_tag : '' %>" placeholder="External/Yahoo" required>
    </label>
    <p class="muted small">Used to prefill labels below. Edit to rename every auto-generated label in one place; rows you have edited are left alone.</p>

    <label>Post-import action
      <select name="post_import_action" id="post-import-action">
        <option value="none" <%= !source || (source.post_import_action || 'none') === 'none' ? 'selected' : '' %>>Leave on source</option>
        <option value="mark_read" <%= source && source.post_import_action === 'mark_read' ? 'selected' : '' %>>Mark as read on source</option>
        <option value="delete" <%= source && source.post_import_action === 'delete' ? 'selected' : '' %>>Delete from source</option>
      </select>
    </label>

    <label id="poll-wrap">Poll interval (seconds, POP only)
      <input type="number" name="poll_interval_seconds" value="<%= source && source.poll_interval_seconds ? source.poll_interval_seconds : 300 %>">
    </label>

    <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap; margin-top:0.75rem;">
      <button type="button" id="test-btn" class="secondary">Test connection</button>
      <span id="test-result" class="muted" aria-live="polite"></span>
    </div>

    <div id="folders-card" class="card" style="margin-top:1rem;">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem; flex-wrap:wrap;">
        <strong>Folders to sync</strong>
        <div style="display:flex; gap:0.5rem; align-items:center;">
          <button type="button" id="discover-btn" class="secondary">Discover folders</button>
          <span id="discover-result" class="muted" aria-live="polite"></span>
        </div>
      </div>

      <p class="muted small" id="folders-empty" style="margin-top:0.75rem;">
        Test the connection first, then click <em>Discover folders</em> to list mailboxes from your source. INBOX is required and will be preselected. You can map multiple source folders into the same Gmail label (e.g. "External/Work") to funnel them.
      </p>

      <div id="folders-table-wrap" hidden>
        <table id="folders-table" class="sources-table" style="margin-top:0.5rem;">
          <colgroup>
            <col style="width: 8%;">
            <col style="width: 38%;">
            <col style="width: 54%;">
          </colgroup>
          <thead>
            <tr>
              <th>Sync</th>
              <th>Source folder</th>
              <th>Gmail label</th>
            </tr>
          </thead>
          <tbody id="folders-tbody"></tbody>
        </table>
        <p class="muted small" id="folders-hint" style="margin-top:0.5rem;"></p>
      </div>

      <input type="hidden" name="folders_json" id="folders-json" value="">
    </div>

    <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
      <button type="submit" id="save-btn"><%= source ? 'Save changes' : 'Add source' %></button>
      <span id="save-hint" class="muted small" aria-live="polite"></span>
    </div>
    <p class="muted">Saving also runs a connection test; if it fails, nothing is stored.</p>
  </form>

  <template id="folder-row-tpl">
    <tr class="folder-row">
      <td class="folder-sync-cell">
        <input type="checkbox" class="folder-sync" checked>
      </td>
      <td class="folder-path"></td>
      <td>
        <input type="text" class="folder-label" autocomplete="off" list="folder-label-suggestions">
      </td>
    </tr>
  </template>

  <datalist id="folder-label-suggestions"></datalist>

  <script id="folders-initial" type="application/json"><%- JSON.stringify(folders || []).replace(/</g, '\\u003c') %></script>
  <script src="/public/sources-form.js" defer></script>
<% } %>

<%- include('../_footer') %>
