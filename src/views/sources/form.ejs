<%- include('../_header', { title: source ? 'Edit source' : 'Add source', user, csrfToken }) %>

<h1><%= source ? 'Edit source' : 'Add source' %></h1>

<% if (flash) { %>
  <div role="alert" class="alert alert-error text-sm my-3"><span><%= flash %></span></div>
<% } %>

<% if (destinations.length === 0) { %>
  <div role="alert" class="alert alert-error text-sm">
    <span>You need to connect a destination before adding a source. <a class="link" href="/destinations">Go to destinations</a>.</span>
  </div>
<% } else { %>
  <details class="collapse collapse-arrow bg-base-200 border border-base-300 mb-4" <%= source ? '' : 'open' %>>
    <summary class="collapse-title font-semibold">Port and TLS cheat-sheet</summary>
    <div class="collapse-content">
      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead><tr><th>Protocol</th><th>Port</th><th>Use TLS</th><th>Notes</th></tr></thead>
          <tbody>
            <tr><td>IMAP</td><td><code>993</code></td><td>yes</td><td>Implicit TLS -- the default, use this.</td></tr>
            <tr><td>IMAP</td><td><code>143</code></td><td>no</td><td>Plaintext; only acceptable on a private network you trust.</td></tr>
            <tr><td>POP</td><td><code>995</code></td><td>yes</td><td>Implicit TLS -- the default, use this.</td></tr>
            <tr><td>POP</td><td><code>110</code></td><td>no</td><td>Plaintext; only on trusted networks.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm text-base-content/60 mt-2">If you see <em>"wrong version number"</em> or an SSL error, you have TLS ticked with a plaintext port (or vice versa). Match the combo above. STARTTLS (TLS on port 143 / 110 after a plaintext handshake) is not currently supported.</p>
    </div>
  </details>

  <form id="source-form" method="POST" action="<%= source ? `/sources/${source.id}` : '/sources' %>" class="flex flex-col gap-3 max-w-2xl">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (source) { %>
      <input type="hidden" name="source_id" value="<%= source.id %>">
    <% } %>

    <label class="form-control">
      <span class="label label-text">Name</span>
      <input type="text" name="name" value="<%= source ? source.name : '' %>" class="input input-bordered w-full max-w-sm" required>
    </label>

    <label class="form-control">
      <span class="label label-text">Type</span>
      <select name="type" class="select select-bordered w-full max-w-sm" required>
        <option value="imap" <%= source && source.type === 'imap' ? 'selected' : '' %>>IMAP</option>
        <option value="pop" <%= source && source.type === 'pop' ? 'selected' : '' %>>POP</option>
      </select>
    </label>

    <label class="form-control">
      <span class="label label-text">Host</span>
      <input type="text" name="host" value="<%= source ? source.host : '' %>" class="input input-bordered w-full max-w-sm" required>
    </label>

    <label class="form-control">
      <span class="label label-text">Port</span>
      <input type="number" name="port" value="<%= source ? source.port : 993 %>" class="input input-bordered w-full max-w-sm" required>
    </label>

    <label class="label cursor-pointer justify-start gap-2">
      <input type="checkbox" name="use_tls" value="1" class="checkbox checkbox-primary" <%= !source || source.use_tls === 1 ? 'checked' : '' %>>
      <span class="label-text">Use TLS</span>
    </label>

    <label class="form-control">
      <span class="label label-text">Username</span>
      <input type="text" name="username" value="<%= source ? source.username : '' %>" class="input input-bordered w-full max-w-sm" required autocomplete="off">
    </label>

    <label class="form-control">
      <span class="label label-text">Password</span>
      <input type="password" name="password" class="input input-bordered w-full max-w-sm" autocomplete="new-password" placeholder="<%= source ? '(leave blank to keep current)' : '' %>">
    </label>

    <label class="form-control">
      <span class="label label-text">Destination</span>
      <select name="destination_id" class="select select-bordered w-full max-w-sm" required>
        <% destinations.forEach(function(d) { %>
          <option value="<%= d.id %>" <%= source && source.destination_id === d.id ? 'selected' : '' %>><%= d.type %>: <%= d.account_identifier || ('id ' + d.id) %></option>
        <% }); %>
      </select>
    </label>

    <label class="form-control">
      <span class="label label-text">Label prefix (Gmail)</span>
      <input type="text" id="label-prefix" name="destination_tag" value="<%= source ? source.destination_tag : '' %>" class="input input-bordered w-full max-w-sm" placeholder="External/Yahoo" required>
      <span class="label-text-alt text-base-content/60 mt-1">Used to prefill labels below. Edit to rename every auto-generated label in one place; rows you have edited are left alone.</span>
    </label>

    <label class="form-control">
      <span class="label label-text">Post-import action</span>
      <select name="post_import_action" id="post-import-action" class="select select-bordered w-full max-w-sm">
        <option value="none" <%= !source || (source.post_import_action || 'none') === 'none' ? 'selected' : '' %>>Leave on source</option>
        <option value="mark_read" <%= source && source.post_import_action === 'mark_read' ? 'selected' : '' %>>Mark as read on source</option>
        <option value="delete" <%= source && source.post_import_action === 'delete' ? 'selected' : '' %>>Delete from source</option>
      </select>
    </label>

    <label class="form-control" id="poll-wrap">
      <span class="label label-text">Poll interval (seconds, POP only)</span>
      <input type="number" name="poll_interval_seconds" value="<%= source && source.poll_interval_seconds ? source.poll_interval_seconds : 300 %>" class="input input-bordered w-full max-w-sm">
    </label>

    <div class="flex gap-2 items-center flex-wrap mt-2">
      <button type="button" id="test-btn" class="btn btn-outline btn-sm">Test connection</button>
      <span id="test-result" class="text-sm text-base-content/60" aria-live="polite"></span>
    </div>

    <div id="folders-card" class="card bg-base-200 border border-base-300 mt-2">
      <div class="card-body">
        <div class="flex items-center justify-between gap-2 flex-wrap">
          <strong>Folders to sync</strong>
          <div class="flex gap-2 items-center">
            <button type="button" id="discover-btn" class="btn btn-outline btn-sm">Discover folders</button>
            <span id="discover-result" class="text-sm text-base-content/60" aria-live="polite"></span>
          </div>
        </div>

        <p class="text-sm text-base-content/60 mt-2" id="folders-empty">
          Test the connection first, then click <em>Discover folders</em> to list mailboxes from your source. INBOX is required and will be preselected. You can map multiple source folders into the same Gmail label (e.g. "External/Work") to funnel them.
        </p>

        <div id="folders-table-wrap" hidden>
          <div class="overflow-x-auto mt-2">
            <table id="folders-table" class="table table-sm">
              <colgroup>
                <col class="w-[8%]">
                <col class="w-[38%]">
                <col class="w-[54%]">
              </colgroup>
              <thead>
                <tr>
                  <th>Sync</th>
                  <th>Source folder</th>
                  <th>Gmail label</th>
                </tr>
              </thead>
              <tbody id="folders-tbody"></tbody>
            </table>
          </div>
          <p class="text-sm text-base-content/60 mt-2" id="folders-hint"></p>
        </div>

        <input type="hidden" name="folders_json" id="folders-json" value="">
      </div>
    </div>

    <div class="flex gap-2 items-center flex-wrap mt-2">
      <button type="submit" id="save-btn" class="btn btn-primary"><%= source ? 'Save changes' : 'Add source' %></button>
      <span id="save-hint" class="text-sm text-base-content/60" aria-live="polite"></span>
    </div>
    <p class="text-sm text-base-content/60">Saving also runs a connection test; if it fails, nothing is stored.</p>
  </form>

  <template id="folder-row-tpl">
    <tr class="folder-row">
      <td class="folder-sync-cell text-center">
        <input type="checkbox" class="folder-sync checkbox checkbox-sm checkbox-primary" checked>
      </td>
      <td class="folder-path whitespace-normal break-words"></td>
      <td>
        <input type="text" class="folder-label input input-bordered input-sm w-full" autocomplete="off" list="folder-label-suggestions">
      </td>
    </tr>
  </template>

  <datalist id="folder-label-suggestions"></datalist>

  <script id="folders-initial" type="application/json"><%- JSON.stringify(folders || []).replace(/</g, '\\u003c') %></script>
  <script src="/public/sources-form.js" defer></script>
<% } %>

<%- include('../_footer') %>
