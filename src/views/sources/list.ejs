<%- include('../_header', { title: 'Sources', user, csrfToken }) %>

<div class="flex items-center justify-between flex-wrap gap-3">
  <h1>Sources</h1>
  <a class="btn btn-primary btn-sm" href="/sources/new">+ Add source</a>
</div>

<% if (flash) { %>
  <div role="alert" class="alert alert-success text-sm my-3"><span><%= flash %></span></div>
<% } %>

<% if (sources.length === 0) { %>
  <div class="card bg-base-200 border border-base-300 mt-2">
    <div class="card-body text-base-content/70">No sources yet.</div>
  </div>
<% } else { %>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-200 mt-4">
    <table class="table table-zebra table-sm">
      <thead>
        <tr>
          <th>Source</th>
          <th>Server</th>
          <th>Tag</th>
          <th>Status</th>
          <th>Last sync</th>
          <th class="text-right" title="Imported / Skipped">Imp./Skip.</th>
          <th>Last error</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% sources.forEach(function(s) { %>
          <tr>
            <td title="<%= s.name %>">
              <div class="font-semibold"><%= s.name %></div>
              <div class="text-xs text-base-content/60"><%= s.type.toUpperCase() %></div>
            </td>
            <td title="<%= s.host %>:<%= s.port %> / <%= s.username %>">
              <div class="font-mono text-sm"><%= s.host %>:<%= s.port %></div>
              <div class="text-xs text-base-content/60"><%= s.username %></div>
            </td>
            <td title="<%= s.destination_tag %>"><%= s.destination_tag %></td>
            <td>
              <% if (s.enabled) { %>
                <span class="badge badge-success badge-sm">enabled</span>
              <% } else { %>
                <span class="badge badge-ghost badge-sm">disabled</span>
              <% } %>
            </td>
            <td class="text-base-content/60" title="<%= s.last_sync_at || '' %>"><%= s.last_sync_at_display %></td>
            <td class="text-right whitespace-nowrap">
              <span><%= s.imported_count !== undefined ? s.imported_count : 0 %></span>
              <span class="text-base-content/60"> / <%= s.skipped_count %></span>
            </td>
            <td class="text-error whitespace-normal max-w-[22rem]"><%= s.last_error || '' %></td>
            <td class="text-right whitespace-nowrap">
              <div class="inline-flex gap-1 justify-end flex-wrap">
                <a href="/sources/<%= s.id %>" class="btn btn-xs btn-outline">Edit</a>
                <form method="POST" action="/sources/<%= s.id %>/toggle" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-xs btn-outline"><%= s.enabled ? 'Disable' : 'Enable' %></button>
                </form>
                <form method="POST" action="/sources/<%= s.id %>/delete" class="inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-xs btn-error">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../_footer') %>
