<%- include('../_header', { title: 'Sources', user, csrfToken }) %>

<h1>Sources</h1>

<% if (flash) { %>
  <div class="card ok"><%= flash %></div>
<% } %>

<p><a class="btn" href="/sources/new">Add source</a></p>

<% if (sources.length === 0) { %>
  <div class="card">No sources yet.</div>
<% } else { %>
  <div class="table-scroll">
  <table class="sources-table">
    <colgroup>
      <col style="width: 17%;">
      <col style="width: 13%;">
      <col style="width: 10%;">
      <col style="width: 8%;">
      <col style="width: 10%;">
      <col style="width: 9%;">
      <col style="width: 11%;">
      <col style="width: 22%;">
    </colgroup>
    <thead>
      <tr>
        <th>Source</th>
        <th>Server</th>
        <th>Tag</th>
        <th>Status</th>
        <th>Last sync</th>
        <th style="text-align:right;" title="Imported / Skipped">Imp./Skip.</th>
        <th class="wrap">Last error</th>
        <th class="actions-col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% sources.forEach(function(s) { %>
        <tr>
          <td title="<%= s.name %>">
            <div><strong><%= s.name %></strong></div>
            <div class="muted small"><%= s.type.toUpperCase() %></div>
          </td>
          <td title="<%= s.host %>:<%= s.port %> / <%= s.username %>">
            <div><%= s.host %>:<%= s.port %></div>
            <div class="muted small"><%= s.username %></div>
          </td>
          <td title="<%= s.destination_tag %>"><%= s.destination_tag %></td>
          <td>
            <% if (s.enabled) { %>
              <span class="ok">enabled</span>
            <% } else { %>
              <span class="muted">disabled</span>
            <% } %>
          </td>
          <td class="muted" title="<%= s.last_sync_at || '' %>"><%= s.last_sync_at_display %></td>
          <td style="text-align:right;">
            <span><%= s.imported_count !== undefined ? s.imported_count : 0 %></span>
            <span class="muted"> / <%= s.skipped_count %></span>
          </td>
          <td class="error wrap" style="max-width:22rem;"><%= s.last_error || '' %></td>
          <td class="actions-col">
            <a href="/sources/<%= s.id %>" class="btn secondary">Edit</a>
            <form method="POST" action="/sources/<%= s.id %>/toggle">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="secondary"><%= s.enabled ? 'Disable' : 'Enable' %></button>
            </form>
            <form method="POST" action="/sources/<%= s.id %>/delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
<% } %>

<%- include('../_footer') %>
