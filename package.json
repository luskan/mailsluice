{
  "name": "mailsluice",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted service that forwards mail from IMAP/POP sources into a primary mailbox (Gmail in v1).",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "rm -rf dist && tsc && cp src/db/schema.sql dist/db/schema.sql && cp -r src/views dist/views && cp -r src/public dist/public",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/view": "^11.1.0",
    "@googleapis/gmail": "^16.0.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.2.0",
    "ejs": "^3.1.10",
    "fastify": "^5.6.1",
    "google-auth-library": "^10.3.0",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.4",
    "node-pop3": "^0.11.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
