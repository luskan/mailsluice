# Encryption key (exactly one of _KEY or _KEY_FILE must be set).
# 32 random bytes base64-encoded. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Alternative to APP_ENCRYPTION_KEY: a path to a file that holds the same
# base64 string. Useful with systemd LoadCredentialEncrypted=, Docker secrets,
# or any mount where the key lives outside this .env file.
# APP_ENCRYPTION_KEY_FILE=/run/credentials/mailsluice/app_encryption_key

# Optional. Previous encryption key (same format) or file path. Set during
# rotation: _PREV decrypts existing data, primary encrypts new writes. Remove
# the previous key once every encrypted row has been touched/re-saved.
APP_ENCRYPTION_KEY_PREV=
# APP_ENCRYPTION_KEY_PREV_FILE=/run/credentials/mailsluice/app_encryption_key_prev

# Required. At least 32 chars. Generate with: openssl rand -hex 32
APP_SESSION_SECRET=

# Optional. Defaults shown.
APP_PORT=3000
APP_HOST=0.0.0.0
APP_DATABASE_PATH=data/mailsluice.db
NODE_ENV=development

# Proxy trust for X-Forwarded-*. Empty = trust no peer (spoof-safe default).
# Behind a reverse proxy (Caddy, nginx, Traefik) set this to "1" (trust 1 hop)
# or a specific proxy IP/CIDR. The --traefik overlay sets this to "1"
# automatically, so you can leave it blank here in that case.
APP_TRUST_PROXY=

# Event log cap (rows). Oldest entries are pruned when exceeded.
APP_EVENT_LOG_MAX_ROWS=10000

# Fixed public base URL (scheme + host[:port], no trailing slash). When set,
# OAuth redirect_uri and other absolute URLs are derived from it instead of
# the Host request header. Recommended when running behind a reverse proxy
# or on a public domain so an attacker cannot shift the OAuth redirect via a
# forged Host header. Example:
# APP_PUBLIC_BASE_URL=https://mailsluice.example.com

# SSRF guard on source hosts. When "0" (default), source hostnames that
# resolve to loopback / RFC1918 / link-local / CGNAT / multicast are
# rejected, so a logged-in user cannot probe the internal network via the
# connection-test flow. Set to "1" only if you really need to fetch mail
# from a LAN / private host.
APP_ALLOW_PRIVATE_SOURCES=0

# Optional HTTP Basic Auth wrapper, format user:password. When set, the browser
# is prompted for this credential before any Mailsluice page loads (except
# /health). Use a long random password, separate from your login password.
# Works over HTTPS only -- over plain HTTP the password travels in the clear.
# APP_HTTP_AUTH=gate:change-me-to-a-long-random-string

# ---- Traefik overlay (only used with: docker-run.sh --traefik, or
#      -f docker-compose.traefik.yml). Leave blank for a plain host-port
#      deployment.
# Public domain routed by Traefik to this container:
# MAILSLUICE_DOMAIN=mailsluice.example.com

# Optional overrides (defaults match the quizpilgrim/Traefik convention):
# TRAEFIK_NETWORK=web
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
# MAILSLUICE_ROUTER_NAME=mailsluice
